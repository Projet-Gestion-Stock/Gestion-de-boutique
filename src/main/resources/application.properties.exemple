spring.application.name=gestion-boutique

server.port=8081

# --- Base de donn�es PostgreSQL ---
spring.datasource.url=jdbc:postgresql://localhost:5432/boutique_db
spring.datasource.username=boutique_user
spring.datasource.password=VOTRE_MOT_DE_PASSE_POSTGRESQL

# --- JPA : Hibernate ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

# --- Thymeleaf ---
spring.thymeleaf.cache=false

# --- Envoi d'images ---
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=5MB
# Dossier de stockage des images (les images de produits sont stocker sur l'ordi dans le sous-dossier "produits").
app.upload.dir=${user.home}/boutique-uploads

# --- Administrateur créé automatiquement au démarrage ---
app.admin.identifiant=admin
app.admin.mot-de-passe=admin123
app.admin.nom=ADMIN
app.admin.prenom=Super
app.admin.matricule=ADM-001

# --- Ticket de caisse ---
app.boutique.nom=Boutique Alimentaire
app.boutique.adresse=Ouagadougou
app.boutique.telephone= 01 02 03 04
app.boutique.devise=FCFA

# --- S�curit� de la session ---
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax